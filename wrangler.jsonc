{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handback",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /h/<id> is a client route, so unknown paths must return the SPA shell.
    "not_found_handling": "single-page-application",
    // Without this the asset layer answers before the Worker runs, so the
    // canonical-host redirect never executes for a static path like "/".
    "run_worker_first": true
  },
  // Apex is canonical. www and the workers.dev subdomain stay reachable so old
  // links keep resolving, and the Worker 301s both to the canonical host.
  "workers_dev": true,
  "routes": [
    { "pattern": "handback.link", "custom_domain": true },
    { "pattern": "www.handback.link", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handback",
      "database_id": "86797b24-bbf8-4f6f-850a-1d552ca3cab0"
    }
  ],
  "observability": { "enabled": true }
}
