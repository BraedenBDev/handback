{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handback",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /h/<id> is a client route, so unknown paths must return the SPA shell.
    "not_found_handling": "single-page-application"
  },
  // Apex is the only origin. www is handled by a zone-level Single Redirect
  // that runs ahead of Workers, and the workers.dev subdomain is retired: two
  // live origins mint two sets of links for the same object.
  "workers_dev": false,
  "routes": [
    { "pattern": "handback.link", "custom_domain": true },
    { "pattern": "www.handback.link", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handback",
      "database_id": "86797b24-bbf8-4f6f-850a-1d552ca3cab0"
    }
  ],
  "observability": { "enabled": true }
}
