# Served by Workers Assets.

# WebMCP is disabled outright in a document whose agent cluster is not
# origin-keyed, and registerTool then rejects with SecurityError. The Worker
# used to add this, but the Worker no longer runs for static paths now that
# run_worker_first is off, so it belongs here instead.
/*
  Origin-Agent-Cluster: ?1

# Handoff pages carry noindex regardless of how a crawler found the link, so a
# shared link never turns into a search result. This is the mechanism that
# actually removes them: robots.txt deliberately does NOT disallow /h/, because
# a crawler blocked from fetching never reads this header and the URL stays
# indexable. See public/robots.txt.
/h/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer

# Vite fingerprints these filenames, so the content at a given path can never
# change. Without this they inherit the Workers Assets default of
# `max-age=0, must-revalidate` and every repeat visit spends a round trip being
# told nothing changed.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
