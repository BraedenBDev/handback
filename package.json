{
  "name": "handback",
  "version": "0.1.0",
  "private": true,
  "description": "Hand off the work. Get it back intact. A WebMCP handoff layer between a person and whichever agent they are using.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,client -c blue,green \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && wrangler dev --port 8787",
    "db:local": "node scripts/migrate-local.mjs .wrangler/state",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && playwright test",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke-live.ts https://handback.link"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
